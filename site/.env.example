# Font Awesome / Web Awesome Pro kit configuration
# Copy this to .env and fill in your values.
# These unlock Pro icon packs via the Web Awesome CDN.
#
# Both values come from your Font Awesome workspace:
#   https://webawesome.com/workspaces
#
# FA_KIT_CODE    — short code from kit.fontawesome.com/<code>.js
# FA_KIT_SEGMENT — segment in the WA Pro CDN URL (ka-p.webawesome.com/kit/<segment>/)
#
PUBLIC_FA_KIT_CODE=your_kit_code_here
PUBLIC_FA_KIT_SEGMENT=your_kit_segment_here
