---
// ─── Curriculum Remix — Layout ────────────────────────────────────────────────
// Web Awesome 3.11 via kit-authenticated CDN (ka-p.webawesome.com)
// Kit code in URL path — this is what enables CORS for cross-origin loading.
// Pattern from sackar-atlas (confirmed working on Cloudflare Pages).
const FA_KIT_CODE = '5cd93bd475';
const WA_KIT_CODE = 'b75567f200a343f9'; // WA kit (separate from FA kit)
const WA_CDN = `https://ka-p.webawesome.com/kit/${WA_KIT_CODE}/webawesome@3.11.0`;

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Curriculum Remix — NSW curriculum data remixed into a navigable, cross-linked format.',
} = Astro.props;

const pageTitle = title === 'Home' ? 'Curriculum Remix' : `${title} — Curriculum Remix`;

import meta from '../data/meta.json';
const fetchDate = new Date(meta.dataFetchedAt + 'T00:00:00');
const dateStr = fetchDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<!doctype html>
<html
  lang="en"
  class="wa-theme-default wa-palette-default wa-light"
  data-fa-kit-code={FA_KIT_CODE}
>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JEGJZ6463D"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JEGJZ6463D');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <!-- Web Awesome 3.11 (kit-authenticated CDN) -->
    <link rel="stylesheet" href={`${WA_CDN}/styles/themes/default.css`} />
    <link rel="stylesheet" href={`${WA_CDN}/styles/utilities.css`} />
    <script type="module" src={`${WA_CDN}/webawesome.loader.js`}></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Sedgwick+Ave+Display&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ─── Design tokens ─────────────────────────────────────────────────────── */
      :root {
        /* Brand */
        --site-brand:      #3E1547; /* brand purple */
        --site-brand-text: #ffffff;

        /* KLA colour palette */
        --kla-english:        #be123c; /* rose-700 */
        --kla-mathematics:    #0f766e; /* teal-700 */
        --kla-science:        #0369a1; /* sky-700 */
        --kla-tas:            #b45309; /* amber-700 */
        --kla-hsie:           #7c3aed; /* violet-700 */
        --kla-creative-arts:  #be185d; /* pink-700 */
        --kla-pdhpe:          #15803d; /* green-700 */
        --kla-languages:      #0e7490; /* cyan-700 */
        --kla-vet:            #9333ea; /* purple-700 */

        /* Link colour — brand blue */
        --wa-color-text-link: var(--site-brand);

        /* Typography */
        --font-display: 'Sedgwick Ave Display', cursive;
        --font-ui: 'Outfit', system-ui, -apple-system, sans-serif;
      }

      html, body {
        min-height: 100%;
        padding: 0;
        margin: 0;
        font-family: var(--font-ui);
      }

      body {
        background-color: var(--wa-color-neutral-95);
      }

      /* ─── Banner (announcement strip above header) ──────────────────────────── */
      .data-strip {
        width: 100%;
        box-sizing: border-box;
        background: #0f172a;
        color: rgba(255,255,255,0.7);
        font-size: 0.72rem;
        letter-spacing: 0.02em;
        padding: 0.35rem var(--wa-space-l);
        display: flex;
        align-items: center;
        gap: var(--wa-space-xs);
        flex-wrap: wrap;
      }

      .data-strip strong {
        color: rgba(255,255,255,0.95);
        font-weight: 500;
      }

      /* ─── Header ─────────────────────────────────────────────────────────────── */
      /* WA applies display:flex + justify-content:space-between to the header slot */
      /* Brand link goes left, nav goes right automatically */
      header[slot='header'] {
        background-color: var(--site-brand);
        color: var(--site-brand-text);
        padding-inline: var(--wa-space-l);
        height: 4rem;
        align-items: center;
      }

      header[slot='header'] a {
        color: var(--site-brand-text);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: var(--wa-space-xs);
      }

      /* Brand name only — display font */
      header[slot='header'] > a {
        font-family: var(--font-display);
        font-size: 1.4rem;
        letter-spacing: 0.04em;
      }

      header[slot='header'] nav {
        display: flex;
        gap: var(--wa-space-m);
      }

      header[slot='header'] nav a {
        font-size: 0.9rem;
        font-weight: 400;
        opacity: 0.85;
      }

      header[slot='header'] nav a:hover {
        opacity: 1;
      }

      /* ─── Footer ─────────────────────────────────────────────────────────────── */
      footer[slot='footer'] {
        background-color: var(--wa-color-neutral-90);
        border-top: 1px solid var(--wa-color-neutral-90);
        padding: var(--wa-space-l) var(--wa-space-xl);
        font-size: 0.85rem;
        color: var(--wa-color-neutral-40);
      }

      /* ─── Links ──────────────────────────────────────────────────────────────── */
      main a,
      footer[slot='footer'] a {
        color: var(--site-brand);
      }

      /* ─── Main content ───────────────────────────────────────────────────────── */
      main {
        padding: var(--wa-space-xl);
        max-width: 72rem;
        margin-inline: auto;
      }
    </style>
  </head>

  <body>
    <wa-page>
      <div slot="banner" class="data-strip">
        <wa-icon name="clock" variant="solid"></wa-icon>
        Data fetched from <strong><a style="color: #FFF;" href="https://curriculum.nsw.edu.au">curriculum.nsw.edu.au</a></strong> on <strong>{dateStr}</strong> | Not affiliated with or endorsed by NESA.
      </div>
      <header slot="header">
        <a href="/">
          <wa-icon name="record-vinyl"></wa-icon>
          Curriculum Remix
        </a>
        <nav>
          <a href="/syllabuses">Syllabuses</a>
          <a href="/primary">Primary</a>
          <a href="/secondary">Secondary</a>
          <a href="/course-descriptions">Courses</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer slot="footer">
        <p>
          Data sourced from <a href="https://curriculum.nsw.edu.au">curriculum.nsw.edu.au</a>.
          Not affiliated with or endorsed by NESA.
        </p>
      </footer>
    </wa-page>
  </body>
</html>

