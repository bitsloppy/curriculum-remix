---
import Layout from '../../layouts/Layout.astro';
import rawCourses from '../../data/course-descriptions.json';
const courses = [...rawCourses].sort((a, b) => a.name.localeCompare(b.name, 'en'));

// ─── KLA filter options ───────────────────────────────────────────────────────
const klas = [
  { slug: 'creative_arts', label: 'Creative Arts' },
  { slug: 'english',       label: 'English' },
  { slug: 'hsie',          label: 'HSIE' },
  { slug: 'languages',     label: 'Languages' },
  { slug: 'mathematics',   label: 'Mathematics' },
  { slug: 'pdhpe',         label: 'PDHPE' },
  { slug: 'science',       label: 'Science' },
  { slug: 'tas',           label: 'TAS' },
];

// ─── Enrolment type options ───────────────────────────────────────────────────
const enrolmentTypes = ['Elective', 'Mandatory'];

// Derive stage group for each course:
// Stage 4 or Stage 5 → "7-10"
// Stage 6 → "11-12"
// Mixed → both
function stageGroup(stages: string[]): string {
  const groups = new Set<string>();
  for (const s of stages) {
    if (s === 'Stage 6') groups.add('11-12');
    else groups.add('7-10');
  }
  return [...groups].join(' ');
}

// CSS variable helper — normalise underscores to hyphens for CSS var name
function klaVar(kla: string) {
  return `--kla-${kla.replace(/_/g, '-')}`;
}

const klaShort: Record<string, string> = {
  creative_arts: 'Cr. Arts',
  english:       'English',
  hsie:          'HSIE',
  languages:     'Languages',
  mathematics:   'Maths',
  pdhpe:         'PDHPE',
  science:       'Science',
  tas:           'TAS',
};

const total = courses.length;
---

<Layout
  title="Course descriptions"
  description="Course enrolment details for all NSW curriculum syllabuses — course name, number, hours, and enrolment type."
>

  <!-- ─── Page intro ────────────────────────────────────────────────────────── -->
  <div class="page-intro">
    <div class="intro-prose">
      <h1 class="page-title">Course descriptions</h1>
      <p>
        Course enrolment details for NSW curriculum syllabuses, sourced from <a href="https://curriculum.nsw.edu.au" target="_blank" rel="noopener">curriculum.nsw.edu.au</a>.
        Use the filters below to narrow by KLA, stage, or enrolment type.
      </p>
    </div>

    <aside class="related-links">
      <h2 class="related-links-heading">
        <wa-icon name="link" variant="solid"></wa-icon>
        Related links
      </h2>
      <ul class="related-links-list">
        <li>
          <a href="https://curriculum.nsw.edu.au/ace-rules/ace3/course-entries" target="_blank" rel="noopener">
            ACE3 — Course entries
          </a>
        </li>
        <li>
          <a href="https://curriculum.nsw.edu.au/ace-rules/ace5/curriculum-requirements" target="_blank" rel="noopener">
            ACE5 — Curriculum requirements
          </a>
        </li>
        <li>
          <a href="https://curriculum.nsw.edu.au/use-the-curriculum/planning-supporting-student-learning/compliance-safety#safety-and-risk-management" target="_blank" rel="noopener">
            Safety and risk management
          </a>
        </li>
        <li>
          <a href="https://curriculum.nsw.edu.au/ace-rules" target="_blank" rel="noopener">
            ACE rules (all)
          </a>
        </li>
      </ul>
    </aside>
  </div>

  <!-- ─── Filter bar ────────────────────────────────────────────────────────── -->
  <div class="filter-bar">
    <div class="filter-left">
      <label class="filter-label" for="kla-select">KLA</label>
      <select id="kla-select" class="filter-select">
        <option value="">All KLAs</option>
        {klas.map(k => <option value={k.slug}>{k.label}</option>)}
      </select>
    </div>

    <div class="filter-chips">
      <button class="chip chip-active" data-filter="stage" data-value="">All stages</button>
      <button class="chip" data-filter="stage" data-value="7-10">7–10</button>
      <button class="chip" data-filter="stage" data-value="11-12">11–12</button>
      <span class="chip-divider"></span>
      <button class="chip chip-mandatory" data-filter="enrolment" data-value="Mandatory">Mandatory</button>
      <button class="chip chip-elective" data-filter="enrolment" data-value="Elective">Elective</button>
      <span class="chip-divider"></span>
      <button class="chip chip-mainstream" data-filter="coursetype" data-value="Mainstream">Mainstream</button>
      <button class="chip chip-lifeskills" data-filter="coursetype" data-value="Life Skills">Life Skills</button>
      <button class="chip chip-extension" data-filter="coursetype" data-value="Extension">Extension</button>
    </div>

    <span class="filter-count">
      <span id="course-count">{total}</span> courses
    </span>
  </div>

  <!-- ─── Table ────────────────────────────────────────────────────────────── -->
  <div class="table-wrap">
    <table class="course-table" id="course-table">
      <thead>
        <tr>
          <th class="col-kla">KLA</th>
          <th class="col-name">Course name</th>
          <th class="col-id">Course no.</th>
          <th class="col-hours">Hours</th>
          <th class="col-enrolment">Enrolment</th>
          <th class="col-type">Type</th>
          <th class="col-syllabus">NSW Curriculum</th>
        </tr>
      </thead>
      <tbody>
        {courses.map(c => (
          <tr
            data-kla={c.kla}
            data-stagegroup={stageGroup(c.stages)}
            data-enrolment={c.enrolmentType}
            data-coursetype={c.courseType}
          >
            <td class="col-kla">
              <span
                class="kla-chip"
                style={`--chip-kla: var(${klaVar(c.kla)})`}
                title={c.klaLabel}
              >
                {klaShort[c.kla] ?? c.klaLabel}
              </span>
            </td>
            <td class="col-name">{c.name}</td>
            <td class="col-id">
              {c.courseId
                ? <code class="course-id">{c.courseId}</code>
                : <span class="tba">TBA</span>}
            </td>
            <td class="col-hours">
              {c.hours
                ? <span class="hours-badge">{c.hours}h</span>
                : '—'}
            </td>
            <td class="col-enrolment">
              {c.enrolmentType
                ? <span class={`enrolment-badge enrolment-${c.enrolmentType.toLowerCase()}`}>{c.enrolmentType}</span>
                : '—'}
            </td>
            <td class="col-type">
              {c.courseType || '—'}
            </td>
            <td class="col-syllabus">
              <a href={`https://curriculum.nsw.edu.au/learning-areas/${c.kla.replace(/_/g, '-')}/${c.syllabusSlug}/overview/course`} class="syl-link" target="_blank" rel="noopener">
                {c.syllabusName}<wa-icon name="up-right-from-square" variant="solid" class="ext-icon"></wa-icon>
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="empty-state" id="course-empty" hidden>No courses match the current filters.</p>

</Layout>

<style>
  /* ─── Page intro ─────────────────────────────────────────────────────────── */
  .page-intro {
    display: grid;
    grid-template-columns: 1fr 22rem;
    gap: var(--wa-space-xl);
    align-items: start;
    margin-block-end: var(--wa-space-l);
  }

  @media (max-width: 768px) {
    .page-intro {
      grid-template-columns: 1fr;
    }
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--wa-color-neutral-10);
    margin-block: 0 var(--wa-space-s);
  }

  .intro-prose p {
    font-size: 0.95rem;
    color: var(--wa-color-neutral-30);
    line-height: 1.6;
    margin-block: 0 var(--wa-space-s);
  }

  .intro-prose a {
    color: var(--site-brand);
  }

  /* ─── Related links box ──────────────────────────────────────────────────── */
  .related-links {
    background: white;
    border: 1px solid var(--wa-color-neutral-90);
    border-left: 3px solid var(--site-brand);
    border-radius: var(--wa-border-radius-m);
    padding: var(--wa-space-m) var(--wa-space-l);
  }

  .related-links-heading {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--wa-color-neutral-50);
    margin-block: 0 var(--wa-space-s);
    display: flex;
    align-items: center;
    gap: var(--wa-space-xs);
  }

  .related-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-xs);
  }

  .related-links-list a {
    font-size: 0.875rem;
    color: var(--site-brand);
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 0.3em;
  }

  .related-links-list a::before {
    content: '→';
    font-size: 0.75em;
    color: var(--wa-color-neutral-60);
    flex-shrink: 0;
  }

  .related-links-list a:hover {
    text-decoration: underline;
  }

  /* ─── Filter bar ─────────────────────────────────────────────────────────── */
  .filter-bar {
    position: sticky;
    top: 4rem;
    z-index: 4;
    background: white;
    border-bottom: 1px solid var(--wa-color-neutral-90);
    padding: var(--wa-space-s) var(--wa-space-xl);
    display: flex;
    align-items: center;
    gap: var(--wa-space-m);
    flex-wrap: wrap;
    margin-inline: calc(-1 * var(--wa-space-xl));
  }

  .filter-left {
    display: flex;
    align-items: center;
    gap: var(--wa-space-s);
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--wa-color-neutral-50);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .filter-select {
    font-size: 0.875rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--wa-color-neutral-80);
    border-radius: var(--wa-border-radius-s);
    background: white;
    color: var(--wa-color-neutral-10);
    cursor: pointer;
  }

  .filter-chips {
    display: flex;
    align-items: center;
    gap: var(--wa-space-xs);
    flex-wrap: wrap;
  }

  .chip {
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--wa-color-neutral-80);
    background: white;
    color: var(--wa-color-neutral-40);
    cursor: pointer;
    transition: background 0.12s, border-color 0.12s, color 0.12s;
  }

  .chip:hover {
    border-color: var(--site-brand);
    color: var(--site-brand);
  }

  .chip.chip-active {
    background: var(--site-brand);
    border-color: var(--site-brand);
    color: white;
  }

  /* Enrolment chips — coloured to match table badges */
  .chip-mandatory {
    background: #dbeafe;
    border-color: #93c5fd;
    color: #1e40af;
  }

  .chip-mandatory:hover,
  .chip-mandatory.chip-active {
    background: #1e40af;
    border-color: #1e40af;
    color: white;
  }

  .chip-elective {
    background: #fef3c7;
    border-color: #fcd34d;
    color: #92400e;
  }

  .chip-elective:hover,
  .chip-elective.chip-active {
    background: #92400e;
    border-color: #92400e;
    color: white;
  }

  /* Course type chips */
  .chip-mainstream {
    background: #dcfce7;
    border-color: #86efac;
    color: #166534;
  }

  .chip-mainstream:hover,
  .chip-mainstream.chip-active {
    background: #166534;
    border-color: #166534;
    color: white;
  }

  .chip-lifeskills {
    background: #f3e8ff;
    border-color: #d8b4fe;
    color: #6b21a8;
  }

  .chip-lifeskills:hover,
  .chip-lifeskills.chip-active {
    background: #6b21a8;
    border-color: #6b21a8;
    color: white;
  }

  .chip-extension {
    background: #ccfbf1;
    border-color: #5eead4;
    color: #0f766e;
  }

  .chip-extension:hover,
  .chip-extension.chip-active {
    background: #0f766e;
    border-color: #0f766e;
    color: white;
  }

  .chip-divider {
    width: 1px;
    height: 1.25rem;
    background: var(--wa-color-neutral-90);
    display: inline-block;
    margin-inline: var(--wa-space-2xs);
  }

  .filter-count {
    margin-inline-start: auto;
    font-size: 0.85rem;
    color: var(--wa-color-neutral-50);
    white-space: nowrap;
  }

  /* ─── Table ──────────────────────────────────────────────────────────────── */
  .table-wrap {
    margin-block-start: var(--wa-space-l);
    overflow-x: auto;
    border: 1px solid var(--wa-color-neutral-90);
    border-radius: var(--wa-border-radius-m);
    background: white;
  }

  .course-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .course-table thead {
    background: var(--wa-color-neutral-95);
  }

  .course-table th {
    position: sticky;
    top: calc(var(--header-height, 4rem) + var(--filter-bar-height, 0px));
    z-index: 3;
    background: var(--wa-color-neutral-95);
    border-bottom: 2px solid var(--wa-color-neutral-90);
    text-align: left;
    padding: var(--wa-space-s) var(--wa-space-m);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--wa-color-neutral-50);
    white-space: nowrap;
  }

  .course-table td {
    padding: var(--wa-space-s) var(--wa-space-m);
    border-bottom: 1px solid var(--wa-color-neutral-90);
    vertical-align: middle;
    color: var(--wa-color-neutral-20);
  }

  .course-table tbody tr:last-child td {
    border-bottom: none;
  }

  .course-table tbody tr:hover td {
    background: var(--wa-color-neutral-95);
  }

  /* Column widths */
  .col-kla        { width: 6rem; }
  .col-name       { min-width: 16rem; }
  .col-id         { width: 7rem; white-space: nowrap; }
  .col-hours      { width: 5rem; text-align: center; }
  .col-enrolment  { width: 8rem; }
  .col-type       { width: 8rem; }
  .col-syllabus   { min-width: 14rem; }

  /* KLA chip */
  .kla-chip {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--chip-kla) 12%, white);
    color: var(--chip-kla);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    display: inline-block;
  }

  /* Course ID */
  .course-id {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    background: var(--wa-color-neutral-90);
    padding: 0.1rem 0.4rem;
    border-radius: var(--wa-border-radius-s);
    color: var(--wa-color-neutral-30);
  }

  .tba {
    font-style: italic;
    color: var(--wa-color-neutral-60);
    font-size: 0.8em;
  }

  /* Hours */
  .hours-badge {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--wa-color-neutral-40);
  }

  /* Enrolment type badge */
  .enrolment-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--wa-border-radius-s);
    font-weight: 500;
  }

  .enrolment-mandatory {
    background: #dbeafe;
    color: #1e40af;
  }

  .enrolment-elective {
    background: #fef3c7;
    color: #92400e;
  }

  /* Syllabus link */
  .syl-link {
    color: var(--site-brand);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--site-brand) 40%, transparent);
    text-underline-offset: 2px;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
  }

  .syl-link:hover {
    text-decoration-color: var(--site-brand);
  }

  .syl-link .ext-icon {
    font-size: 0.65em;
    flex-shrink: 0;
    align-self: center;
    color: var(--site-brand);
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: var(--wa-space-3xl);
    color: var(--wa-color-neutral-50);
  }
</style>

<script>
  const table       = document.getElementById('course-table') as HTMLTableElement;
  const countEl     = document.getElementById('course-count')!;
  const emptyEl     = document.getElementById('course-empty') as HTMLParagraphElement;
  const klaSelect   = document.getElementById('kla-select') as HTMLSelectElement;

  // Measure filter bar height → CSS var (drives sticky thead top offset)
  const filterBarEl = document.querySelector<HTMLElement>('.filter-bar');
  function syncFilterBarHeight() {
    document.documentElement.style.setProperty(
      '--filter-bar-height',
      (filterBarEl?.offsetHeight ?? 0) + 'px'
    );
  }
  syncFilterBarHeight();
  if (filterBarEl) new ResizeObserver(syncFilterBarHeight).observe(filterBarEl);

  // Track active filter values
  let activeStage    = '';
  let activeEnrolment = '';
  let activeCourseType = '';

  function applyFilters() {
    const kla = klaSelect.value;
    const rows = table.querySelectorAll<HTMLTableRowElement>('tbody tr');
    let visible = 0;

    rows.forEach(row => {
      const matchKla       = !kla            || row.dataset.kla       === kla;
      const matchStage     = !activeStage    || row.dataset.stagegroup?.includes(activeStage);
      const matchEnrolment   = !activeEnrolment   || row.dataset.enrolment  === activeEnrolment;
    const matchCourseType  = !activeCourseType  || row.dataset.coursetype === activeCourseType;

      const show = matchKla && matchStage && matchEnrolment && matchCourseType;
      row.hidden = !show;
      if (show) visible++;
    });

    countEl.textContent = String(visible);
    emptyEl.hidden = visible > 0;
    table.closest('.table-wrap')!.toggleAttribute('hidden', visible === 0);
  }

  klaSelect.addEventListener('change', applyFilters);

  // Stage chips — single-select (click active to deselect)
  document.querySelectorAll<HTMLButtonElement>('[data-filter="stage"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.dataset.value!;
      if (activeStage === val) {
        // deselect → back to All
        activeStage = '';
        document.querySelectorAll('[data-filter="stage"]').forEach(b => b.classList.remove('chip-active'));
        document.querySelector<HTMLButtonElement>('[data-filter="stage"][data-value=""]')!.classList.add('chip-active');
      } else {
        activeStage = val;
        document.querySelectorAll('[data-filter="stage"]').forEach(b => b.classList.remove('chip-active'));
        btn.classList.add('chip-active');
      }
      applyFilters();
    });
  });

  // Enrolment chips — toggle (click active to deselect)
  document.querySelectorAll<HTMLButtonElement>('[data-filter="enrolment"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.dataset.value!;
      if (activeEnrolment === val) {
        activeEnrolment = '';
        btn.classList.remove('chip-active');
      } else {
        activeEnrolment = val;
        document.querySelectorAll('[data-filter="enrolment"]').forEach(b => b.classList.remove('chip-active'));
        btn.classList.add('chip-active');
      }
      applyFilters();
    });
  });

  // Course type chips — toggle (click active to deselect)
  document.querySelectorAll<HTMLButtonElement>('[data-filter="coursetype"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.dataset.value!;
      if (activeCourseType === val) {
        activeCourseType = '';
        btn.classList.remove('chip-active');
      } else {
        activeCourseType = val;
        document.querySelectorAll('[data-filter="coursetype"]').forEach(b => b.classList.remove('chip-active'));
        btn.classList.add('chip-active');
      }
      applyFilters();
    });
  });
</script>
