<script>
  // Examples toggle
  const examplesToggle = document.getElementById('examples-toggle') as HTMLButtonElement | null;
  examplesToggle?.addEventListener('click', () => {
    const isVisible = examplesToggle.dataset.state === 'visible';
    const newState = isVisible ? 'hidden' : 'visible';
    examplesToggle.dataset.state = newState;
    examplesToggle.setAttribute('aria-pressed', String(!isVisible));
    const icon = examplesToggle.querySelector('wa-icon');
    if (icon) icon.setAttribute('name', isVisible ? 'eye' : 'eye-slash');
    const textNodes = [...examplesToggle.childNodes].filter(n => n.nodeType === Node.TEXT_NODE);
    if (textNodes.length) textNodes[0].textContent = isVisible ? ' Show examples' : ' Hide examples';
    document.querySelector<HTMLElement>('.content-body')?.classList.toggle('show-examples', !isVisible);
  });

  // ── Content nav scroll spy ──────────────────────────────────────────────
  function initContentNav() {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('.content-stage, .content-fa')
    );
    if (!sections.length) return;

    const allFAs  = Array.from(document.querySelectorAll<HTMLElement>('.content-fa'));
    const pager   = document.getElementById('fa-pager')           as HTMLElement       | null;
    const prevBtn = document.getElementById('fa-pager-prev')      as HTMLButtonElement | null;
    const nextBtn = document.getElementById('fa-pager-next')      as HTMLButtonElement | null;
    const prevLbl = document.getElementById('fa-pager-prev-label') as HTMLElement      | null;
    const nextLbl = document.getElementById('fa-pager-next-label') as HTMLElement      | null;
    const counter = document.getElementById('fa-pager-counter')   as HTMLElement       | null;

    const HEADER_OFFSET = 130; // px — site header (64px) + sticky tab nav (~48px) + margin

    function getActiveId(): string | null {
      let activeId: string | null = null;
      for (const sec of sections) {
        const rect = sec.getBoundingClientRect();
        // rect.width > 0 guards against hidden tab panels (display:none → zero dims)
        if (rect.width > 0 && rect.top <= HEADER_OFFSET) activeId = sec.id;
      }
      return activeId;
    }

    function resolveFaIdx(activeId: string): number {
      const el = document.getElementById(activeId);
      if (el?.classList.contains('content-fa'))
        return allFAs.findIndex(fa => fa.id === activeId);
      if (el?.classList.contains('content-stage')) {
        const first = el.querySelector<HTMLElement>('.content-fa');
        if (first) return allFAs.findIndex(fa => fa.id === first.id);
      }
      return -1;
    }

    function updatePager(activeId: string) {
      if (!pager || !allFAs.length) return;
      const idx = resolveFaIdx(activeId);
      if (idx === -1) return;
      const prev = idx > 0 ? allFAs[idx - 1] : null;
      const next = idx < allFAs.length - 1 ? allFAs[idx + 1] : null;
      if (prevLbl) prevLbl.textContent = prev?.querySelector('.fa-section-title')?.textContent?.trim() ?? '';
      if (nextLbl) nextLbl.textContent = next?.querySelector('.fa-section-title')?.textContent?.trim() ?? '';
      if (counter) counter.textContent = `${idx + 1} / ${allFAs.length}`;
      if (prevBtn) {
        prevBtn.style.visibility = prev ? 'visible' : 'hidden';
        prevBtn.onclick = prev ? () => prev.scrollIntoView({ behavior: 'smooth', block: 'start' }) : null;
      }
      if (nextBtn) {
        nextBtn.style.visibility = next ? 'visible' : 'hidden';
        nextBtn.onclick = next ? () => next.scrollIntoView({ behavior: 'smooth', block: 'start' }) : null;
      }
    }

    function updateNav() {
      const activeId = getActiveId();
      if (!activeId) return;
      const el = document.getElementById(activeId);
      if (!el) return;

      // Clear all active states
      document.querySelectorAll<HTMLElement>('.cnav-stage-link, .cnav-fa-link')
        .forEach(l => l.classList.remove('active'));

      // Activate the matching nav link
      const activeLink = document.querySelector<HTMLElement>(
        `.cnav-fa-link[href="#${activeId}"], .cnav-stage-link[href="#${activeId}"]`
      );
      activeLink?.classList.add('active');
      activeLink?.scrollIntoView({ block: 'nearest' });

      // If it's a FA, also activate its parent stage link
      if (el.classList.contains('content-fa')) {
        const stage = el.closest<HTMLElement>('.content-stage');
        if (stage)
          document.querySelector<HTMLElement>(`.cnav-stage-link[href="#${stage.id}"]`)
            ?.classList.add('active');
      }

      updatePager(activeId);
    }

    // rAF-throttled scroll listener
    let rafPending = false;
    window.addEventListener('scroll', () => {
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(() => { updateNav(); rafPending = false; });
      }
    }, { passive: true });

    const tabGroup = document.querySelector('wa-tab-group');
    tabGroup?.addEventListener('wa-tab-show', (e: any) => {
      if (e.detail?.name === 'content') {
        if (pager) pager.hidden = false;
        updateNav();
      }
    });
    tabGroup?.addEventListener('wa-tab-hide', (e: any) => {
      if (e.detail?.name === 'content' && pager) pager.hidden = true;
    });

    // Pager hidden until content tab is active
    if (pager) pager.hidden = true;
    updateNav();
  }

  initContentNav();

  // ── Overview nav scroll spy ────────────────────────────────────
  function initOverviewNav() {
    const nav = document.querySelector<HTMLElement>('.ov-nav');
    if (!nav) return;

    // Gather anchored overview sections in DOM order
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('.ov-section[id], wa-details[id], #ov-course-details')
    ).filter(el => el.id);
    if (!sections.length) return;

    const HEADER_OFFSET = 130;

    function getActiveId(): string | null {
      let activeId: string | null = null;
      for (const sec of sections) {
        const rect = sec.getBoundingClientRect();
        if (rect.width > 0 && rect.top <= HEADER_OFFSET) activeId = sec.id;
      }
      return activeId;
    }

    function updateOverviewNav() {
      const activeId = getActiveId();
      if (!activeId) return;
      document.querySelectorAll<HTMLElement>('.onav-link')
        .forEach(l => l.classList.remove('active'));
      const link = document.querySelector<HTMLElement>(`.onav-link[href="#${activeId}"]`);
      link?.classList.add('active');
      link?.scrollIntoView({ block: 'nearest' });
    }

    let rafPending = false;
    window.addEventListener('scroll', () => {
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(() => { updateOverviewNav(); rafPending = false; });
      }
    }, { passive: true });

    document.querySelector('wa-tab-group')?.addEventListener('wa-tab-show', (e: any) => {
      if (e.detail?.name === 'overview') updateOverviewNav();
    });

    updateOverviewNav();
  }

  initOverviewNav();

  document.querySelectorAll<HTMLButtonElement>('.ov-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      if (!targetId) return;
      // Update button states
      btn.closest('.ov-toggle')?.querySelectorAll('.ov-toggle-btn').forEach(b => {
        b.classList.toggle('active', b === btn);
      });
      // Show/hide views
      document.querySelectorAll<HTMLElement>('.outcomes-view').forEach(view => {
        view.hidden = view.id !== targetId;
      });
    });
  });
</script>
