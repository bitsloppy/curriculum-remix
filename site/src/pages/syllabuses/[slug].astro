---
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import Layout from '../../layouts/Layout.astro';
import syllabuses from '../../data/syllabuses.json';

export function getStaticPaths() {
  return syllabuses.map(s => ({
    params: { slug: s.slug },
    props:  { syllabus: s },
  }));
}

const { syllabus: s } = Astro.props;

// Load transformed content JSON (may not exist for zero-content syllabuses)
const contentPath = join(process.cwd(), 'src/data/content', `${s.slug}.json`);
const content = existsSync(contentPath)
  ? JSON.parse(readFileSync(contentPath, 'utf-8'))
  : null;

const stages = content?.stages ?? [];
const hasContent = stages.length > 0;

// Stage → year range label
const lifeSkillsYears = s.stage === '11–12' ? 'Years 11–12' : 'Years 7–10';

// Stage group mapping (for jump buttons)
const stageGroupMap: Record<string, string> = {
  early_stage_1: 'k6',
  stage_1:       'k6',
  stage_2:       'k6',
  stage_3:       'k6',
  stage_4:       '7-10',
  stage_5:       '7-10',
  year_11:       '11-12',
  year_12:       '11-12',
  stage_6:       '11-12',
  life_skills:   s.stage === '11–12' ? '11-12' : '7-10',
};

// Stage header shade (light → medium → dark)
const stageShadeMap: Record<string, string> = {
  early_stage_1: 'light',
  stage_1:       'light',
  stage_2:       'light',
  stage_3:       'light',
  stage_4:       'medium',
  stage_5:       'medium',
  year_11:       'light',
  year_12:       'medium',
  stage_6:       'medium',
  life_skills:   'dark',
};

// Which groups are present in this syllabus?
const presentGroups = [...new Set(
  (stages as any[]).map((st: any) => stageGroupMap[st.codename]).filter(Boolean)
)];
const hasK6   = presentGroups.includes('k6');
const has710  = presentGroups.includes('7-10');
const showJumpNav = hasK6 && has710;

// Cross-stage outcomes matrix
const allFocusAreaNames: string[] = [];
{
  const seen = new Set<string>();
  for (const st of stages) {
    for (const fa of (st as any).focusAreas ?? []) {
      if (!seen.has(fa.title)) {
        seen.add(fa.title);
        allFocusAreaNames.push(fa.title);
      }
    }
  }
}
type OutcomeItem = { code: string; description: string };
const overarchingOutcomes: OutcomeItem[] = content?.overarchingOutcomes ?? [];
const stageOutcomesMaps: Record<string, OutcomeItem[]>[] = (stages as any[]).map(st => {
  const map: Record<string, OutcomeItem[]> = {};
  for (const fa of st.focusAreas ?? []) {
    if (!map[fa.title]) map[fa.title] = [];
    map[fa.title].push(...(fa.outcomes ?? []));
  }
  return map;
});
const stageYears: Record<string, string> = {
  early_stage_1: 'Kindergarten',
  stage_1: 'Years 1–2',
  stage_2: 'Years 3–4',
  stage_3: 'Years 5–6',
  stage_4: 'Years 7–8',
  stage_5: 'Years 9–10',
  year_11: 'Year 11',
  year_12: 'Year 12',
  stage_6: 'Years 11–12',
  life_skills: lifeSkillsYears,
};

const klaColor = `var(--kla-${s.kla ?? 'english'})`;

const stageLabels: Record<string, string> = {
  'K–6':   'Primary (K–6)',
  'K–10':  'Primary & Secondary (K–10)',
  '7–8':   'Early Secondary (7–8)',
  '7–10':  'Secondary (7–10)',
  '11–12': 'Senior Secondary (11–12)',
};
const stageLabel = stageLabels[s.stage] ?? s.stage;

const classifParts: string[] = [];
if (s.isMandatory && s.isElective) classifParts.push('Mandatory + Elective choice');
else if (s.isMandatory) classifParts.push('Mandatory');
else if (s.isElective) classifParts.push(`Elective${s.electivePeriods ? ` (${s.electivePeriods} periods)` : ''}`);
---

<Layout title={s.name} description={`${s.name} — NSW ${s.klaLabel} syllabus, ${s.stage}.`}>

  <!-- ─── Breadcrumb ──────────────────────────────────────────────────────── -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <wa-icon name="chevron-right" variant="solid"></wa-icon>
    <a href="/syllabuses">Syllabuses</a>
    <wa-icon name="chevron-right" variant="solid"></wa-icon>
    <span>{s.name}</span>
  </nav>

  <!-- ─── Header ─────────────────────────────────────────────────────────── -->
  <header class="syl-header" style={`--accent: ${klaColor}`}>
    <div class="syl-header-chips">
      <span class="kla-chip" style={`--chip-kla: ${klaColor}`}>{s.klaLabel}</span>
      {s.type === 'LS' && <span class="ls-chip">Life Skills</span>}
    </div>
    <h1>{s.name}</h1>
    <p class="syl-subtitle">{stageLabel}{s.publicationYear ? ` · Published ${s.publicationYear}` : ''}</p>
    {s.hasContent
      ? <a href={s.curriculumUrl} target="_blank" rel="noopener" class="syl-curriculum-link">
          View on curriculum.nsw.edu.au
          <wa-icon name="arrow-up-right-from-square" variant="solid"></wa-icon>
        </a>
      : <p class="syl-not-available">Not available on curriculum.nsw.edu.au when this data was fetched.</p>
    }
  </header>

  {hasContent ? (
    <>
      <h2 class="outcomes-heading">Outcomes</h2>

      <!-- ─── Controls bar: jump nav + view toggle ────────────────────────── -->
      <div class="outcomes-controls">

        {showJumpNav && (
          <div class="stage-nav" role="group" aria-label="Jump to stage">
            <span class="stage-nav-label">Jump to</span>
            <button class="stage-chip" data-stagejump="k6">K–6</button>
            <button class="stage-chip" data-stagejump="7-10">7–10</button>
          </div>
        )}

        <div class="ov-toggle" role="group" aria-label="Outcomes view">
          <button class="ov-toggle-btn active" data-target="outcomes-default">Default</button>
          <button class="ov-toggle-btn" data-target="outcomes-continuum">Continuum of learning</button>
        </div>

      </div>

      <!-- ─── Default view: stage columns ───────────────────────────────── -->
      <div id="outcomes-default" class="outcomes-view">

        {overarchingOutcomes.length > 0 && (
          <div class="overarching-bar">
            <span class="overarching-label">Overarching outcome</span>
            {overarchingOutcomes.map(oc => (
              <div class="overarching-card">
                <span class="outcome-code">{oc.code}</span>
                <div class="outcome-desc" set:html={oc.description} />
              </div>
            ))}
          </div>
        )}

        <div class="stage-columns">
          {(stages as any[]).map(st => (
            <div class="stage-col" data-stagegroup={stageGroupMap[st.codename]} data-shade={stageShadeMap[st.codename]}>
              <div class="stage-col-header">
                <span class="stage-col-name">{st.name}</span>
                {stageYears[st.codename] && (
                  <span class="stage-col-years">{stageYears[st.codename]}</span>
                )}
              </div>
              <div class="stage-col-body">
                {(st.focusAreas ?? []).map((fa: any) => (
                  fa.outcomes.length > 0 && (
                    fa.outcomes.map((oc: OutcomeItem) => (
                      <div class="outcome-card">
                        <span class="outcome-code">{oc.code}</span>
                        <span class="outcome-fa-title">{fa.title}</span>
                        <div class="outcome-desc" set:html={oc.description} />
                      </div>
                    ))
                  )
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ─── Continuum view: frozen-left matrix ─────────────────────────── -->
      <div id="outcomes-continuum" class="outcomes-view" hidden>
        <div class="om-scroll">
          <div
            class="outcomes-matrix"
            id="outcomes-matrix"
            style={`grid-template-columns: 200px repeat(${stages.length}, 300px)`}
          >
            <!-- Header row -->
            <div class="om-cell om-header om-frozen">Outcome</div>
            {(stages as any[]).map(st => (
              <div
                class="om-cell om-header"
                data-col={st.codename}
                data-stagegroup={stageGroupMap[st.codename]}
              >
                <span class="om-stage-name">{st.name}</span>
                {stageYears[st.codename] && (
                  <span class="om-stage-years">{stageYears[st.codename]}</span>
                )}
              </div>
            ))}

            <!-- Data rows — one per focus area -->
            {allFocusAreaNames.map((faName, ri) => (
              <>
                <div class={`om-cell om-row-label om-frozen${ri % 2 === 1 ? ' om-stripe' : ''}`}>
                  {faName}
                </div>
                {stageOutcomesMaps.map((map, si) => (
                  <div
                    class={`om-cell om-data${ri % 2 === 1 ? ' om-stripe' : ''}`}
                    data-col={(stages as any[])[si].codename}
                    data-stagegroup={stageGroupMap[(stages as any[])[si].codename]}
                  >
                    {(map[faName] ?? []).length > 0
                      ? (map[faName] ?? []).map((oc: OutcomeItem) => (
                          <div class="outcome-card">
                            <span class="outcome-code">{oc.code}</span>
                            <div class="outcome-desc" set:html={oc.description} />
                          </div>
                        ))
                      : <span class="om-empty">No outcome for this stage</span>
                    }
                  </div>
                ))}
              </>
            ))}
          </div>
        </div>
      </div>
    </>
  ) : (
    <div class="no-content">
      <div class="info-cards">
        <div class="info-card">
          <h2>Course details</h2>
          <dl>
            <dt>Learning area</dt><dd>{s.klaLabel}</dd>
            <dt>Stage</dt><dd>{s.stage}</dd>
            <dt>Course type</dt><dd>{s.type === 'LS' ? 'Life Skills' : 'Mainstream'}</dd>
            {classifParts.length > 0 && <><dt>Classification</dt><dd>{classifParts.join(', ')}</dd></>}
            {s.publicationYear && <><dt>Published</dt><dd>{s.publicationYear}</dd></>}
          </dl>
        </div>
        <div class="info-card">
          <div class="coming-soon">
            <wa-icon name="clock" variant="regular"></wa-icon>
            <p>Content for this syllabus is not yet available on curriculum.nsw.edu.au.</p>
            {s.curriculumUrl && (
              <a href={s.curriculumUrl} target="_blank" rel="noopener" class="ext-link">
                Check curriculum.nsw.edu.au
                <wa-icon name="arrow-up-right-from-square" variant="solid"></wa-icon>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- ─── Back link ───────────────────────────────────────────────────────── -->
  <div class="back-link">
    <a href="/syllabuses">
      <wa-icon name="arrow-left" variant="solid"></wa-icon>
      Back to all syllabuses
    </a>
  </div>

</Layout>

<script>
  // ── View toggle (Default / Continuum) ──────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.ov-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      if (!targetId) return;
      btn.closest('.ov-toggle')?.querySelectorAll('.ov-toggle-btn').forEach(b => {
        b.classList.toggle('active', b === btn);
      });
      document.querySelectorAll<HTMLElement>('.outcomes-view').forEach(view => {
        view.hidden = view.id !== targetId;
      });
    });
  });

  // ── Stage jump buttons ──────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('[data-stagejump]').forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.stagejump!;
      const activeView = document.querySelector<HTMLElement>('.outcomes-view:not([hidden])');
      if (!activeView) return;

      if (activeView.id === 'outcomes-default') {
        const container = activeView.querySelector<HTMLElement>('.stage-columns');
        const target    = activeView.querySelector<HTMLElement>(`.stage-col[data-stagegroup="${group}"]`);
        if (container && target) {
          const offset = container.scrollLeft + target.getBoundingClientRect().left - container.getBoundingClientRect().left;
          container.scrollTo({ left: offset, behavior: 'smooth' });
        }
      } else {
        const container = activeView.querySelector<HTMLElement>('.om-scroll');
        const target    = activeView.querySelector<HTMLElement>(`.om-header[data-stagegroup="${group}"]`);
        if (container && target) {
          const offset = container.scrollLeft + target.getBoundingClientRect().left - container.getBoundingClientRect().left - 200;
          container.scrollTo({ left: Math.max(0, offset), behavior: 'smooth' });
        }
      }
    });
  });
</script>

<style>
  /* ── Breadcrumb ─────────────────────────────────────────────────────────── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--wa-space-xs);
    font-size: 0.85rem;
    color: var(--wa-color-neutral-50);
    margin-block-end: var(--wa-space-l);
  }
  .breadcrumb a { color: var(--site-brand); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb wa-icon { font-size: 0.65rem; color: var(--wa-color-neutral-60); }

  /* ── Header ─────────────────────────────────────────────────────────────── */
  .syl-header {
    border-left: 4px solid var(--accent);
    padding-inline-start: var(--wa-space-m);
    margin-block-end: var(--wa-space-xl);
  }
  .syl-header-chips {
    display: flex;
    gap: var(--wa-space-xs);
    flex-wrap: wrap;
    margin-block-end: var(--wa-space-s);
  }
  .syl-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    margin: 0 0 var(--wa-space-2xs);
    line-height: 1.25;
  }
  .syl-subtitle { font-size: 0.95rem; color: var(--wa-color-neutral-50); margin: 0; }

  /* ── Chips ───────────────────────────────────────────────────────────────── */
  .kla-chip {
    font-size: 0.75rem; font-weight: 600;
    padding: 0.2rem 0.6rem; border-radius: 999px;
    background: color-mix(in srgb, var(--chip-kla) 12%, white);
    color: var(--chip-kla); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .ls-chip {
    font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 999px;
    background: var(--wa-color-neutral-90); color: var(--wa-color-neutral-40); font-style: italic;
  }
  .syl-curriculum-link {
    display: inline-flex;
    align-items: center;
    gap: var(--wa-space-2xs);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--site-brand);
    text-decoration: none;
    margin-block-start: var(--wa-space-xs);
  }
  .syl-curriculum-link:hover { text-decoration: underline; }
  .syl-curriculum-link wa-icon { font-size: 0.75em; }

  .syl-not-available {
    font-size: 0.875rem;
    color: var(--wa-color-neutral-50);
    font-style: italic;
    margin: var(--wa-space-xs) 0 0;
  }

  /* ── Outcomes heading ────────────────────────────────────────────────────── */
  .outcomes-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--wa-color-neutral-10);
    margin: 0 0 var(--wa-space-l);
  }

  /* ── Controls bar ────────────────────────────────────────────────────────── */
  .outcomes-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wa-space-m);
    flex-wrap: wrap;
    margin-block-end: var(--wa-space-l);
    padding-block-end: var(--wa-space-l);
    border-bottom: 1px solid var(--wa-color-neutral-90);
  }

  /* ── Stage jump nav ──────────────────────────────────────────────────────── */
  .stage-nav {
    display: flex;
    align-items: center;
    gap: var(--wa-space-xs);
  }
  .stage-nav-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--wa-color-neutral-50);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .stage-chip {
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--wa-color-neutral-80);
    background: white;
    color: var(--wa-color-neutral-40);
    cursor: pointer;
    font-family: var(--font-ui, system-ui);
    transition: background 0.12s, border-color 0.12s, color 0.12s;
  }
  .stage-chip:hover {
    border-color: var(--site-brand);
    color: var(--site-brand);
    background: color-mix(in srgb, var(--site-brand) 6%, white);
  }

  /* ── View toggle ─────────────────────────────────────────────────────────── */
  .ov-toggle {
    display: flex;
    border: 1px solid var(--wa-color-neutral-90);
    border-radius: var(--wa-border-radius-m);
    overflow: hidden;
    flex-shrink: 0;
  }
  .ov-toggle-btn {
    background: none;
    border: none;
    border-right: 1px solid var(--wa-color-neutral-90);
    padding: var(--wa-space-xs) var(--wa-space-m);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    color: var(--wa-color-neutral-40);
    font-family: var(--font-ui, system-ui);
  }
  .ov-toggle-btn:last-child { border-right: none; }
  .ov-toggle-btn.active {
    background: var(--site-brand);
    color: white;
    font-weight: 600;
  }
  .ov-toggle-btn:hover:not(.active) { background: var(--wa-color-neutral-95); }
  .outcomes-view { margin-block-start: var(--wa-space-l); }

  /* ── Overarching outcomes bar ──────────────────────────────────────────────── */
  .overarching-bar {
    position: sticky;
    top: var(--header-height, 4rem);
    z-index: 3;
    background: color-mix(in srgb, var(--accent, var(--site-brand)) 5%, white);
    border: 1px solid color-mix(in srgb, var(--accent, var(--site-brand)) 22%, transparent);
    border-radius: var(--wa-border-radius-m);
    padding: var(--wa-space-m) var(--wa-space-l);
    margin-block-end: var(--wa-space-l);
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-s);
  }
  .overarching-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent, var(--site-brand));
    margin-block-end: var(--wa-space-2xs);
  }
  .overarching-card {
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-2xs);
  }
  .overarching-card + .overarching-card {
    padding-block-start: var(--wa-space-s);
    border-top: 1px solid color-mix(in srgb, var(--accent, var(--site-brand)) 15%, transparent);
  }

  /* ── Outcomes matrix ────────────────────────────────────────────────────── */
  .om-scroll {
    overflow-x: auto;
    border: 1px solid var(--wa-color-neutral-90);
    border-radius: var(--wa-border-radius-m);
    margin-block-end: var(--wa-space-xl);
  }
  .outcomes-matrix {
    display: grid;
    width: max-content;
    min-width: 100%;
  }
  .om-cell {
    padding: var(--wa-space-xs) var(--wa-space-s);
    border-right: 1px solid var(--wa-color-neutral-90);
    border-bottom: 1px solid var(--wa-color-neutral-90);
  }
  .om-header {
    background: var(--wa-color-neutral-95);
    font-size: 0.78rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--wa-color-neutral-40);
    display: flex; flex-direction: column; justify-content: flex-end;
    gap: 0.15rem;
    padding-block: var(--wa-space-m);
    border-bottom: 2px solid var(--wa-color-neutral-80);
  }
  .om-stage-name { font-size: 0.85rem; font-weight: 700; color: var(--wa-color-neutral-20); text-transform: none; letter-spacing: normal; }
  .om-stage-years { font-size: 0.72rem; color: var(--wa-color-neutral-50); text-transform: none; letter-spacing: normal; font-weight: 500; }
  .om-frozen {
    position: sticky;
    left: 0;
    z-index: 2;
  }
  .om-header.om-frozen {
    z-index: 3;
    border-right: 2px solid var(--wa-color-neutral-80);
  }
  .om-row-label {
    font-size: 0.95rem; font-weight: 600;
    color: var(--wa-color-neutral-20);
    display: flex; align-items: center;
    background: white;
    border-right: 2px solid var(--wa-color-neutral-90);
    line-height: 1.35;
  }
  .om-empty {
    font-size: 0.78rem;
    color: var(--wa-color-neutral-60, #9ca3af);
    font-style: italic;
  }
  .om-stripe { background: var(--wa-color-neutral-98, #fafafa); }
  .om-row-label.om-stripe { background: var(--wa-color-neutral-98, #fafafa); }
  .om-data {
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-xs);
    align-items: flex-start;
  }

  /* ── Outcome cards ───────────────────────────────────────────────────────── */
  .outcome-card {
    background: white;
    border: 1px solid var(--wa-color-neutral-90);
    border-radius: var(--wa-border-radius-m);
    padding: var(--wa-space-m);
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    box-sizing: border-box;
    margin-block-end: var(--wa-space-s);
  }
  .outcome-card:last-child { margin-block-end: 0; }
  .om-stripe .outcome-card { background: white; }
  .outcome-code {
    font-size: 0.75rem; font-weight: 700; font-family: monospace;
    color: var(--site-brand);
    background: color-mix(in srgb, var(--site-brand) 8%, white);
    padding: 0.15rem 0.45rem; border-radius: var(--wa-border-radius-s);
    white-space: nowrap; align-self: start;
    margin-block-end: var(--wa-space-m);
  }
  .outcome-fa-title {
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--wa-color-neutral-50);
    margin-block-end: var(--wa-space-2xs);
  }
  .outcome-desc { font-size: 0.875rem; line-height: 1.5; color: var(--wa-color-neutral-20); }
  .outcome-desc p { margin: 0; }

  /* ── Stage columns (default view) ───────────────────────────────────────── */
  .stage-columns {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--wa-space-m)) / 3);
    gap: var(--wa-space-m);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block-end: var(--wa-space-s);
    align-items: start;
  }
  .stage-col {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .stage-col-header {
    border-radius: var(--wa-border-radius-m);
    padding: var(--wa-space-s) var(--wa-space-m);
    margin-block-end: var(--wa-space-m);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
