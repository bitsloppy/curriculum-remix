---
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import Layout from '../../layouts/Layout.astro';
import syllabuses from '../../data/syllabuses.json';

export function getStaticPaths() {
  return syllabuses.map(s => ({
    params: { slug: s.slug },
    props:  { syllabus: s },
  }));
}

const { syllabus: s } = Astro.props;

// Load transformed content JSON (may not exist for zero-content syllabuses)
const contentPath = join(process.cwd(), 'src/data/content', `${s.slug}.json`);
const content = existsSync(contentPath)
  ? JSON.parse(readFileSync(contentPath, 'utf-8'))
  : null;

// Load glossary data
const glossaryPath = join(process.cwd(), 'src/data/glossary', `${s.slug}.json`);
const glossaryData = existsSync(glossaryPath)
  ? JSON.parse(readFileSync(glossaryPath, 'utf-8'))
  : null;
type GlossaryTerm = { id: string; codename: string; title: string; slug: string; description: string };
const glossaryShared: GlossaryTerm[]   = glossaryData?.shared   ?? [];
const glossarySpecific: GlossaryTerm[] = glossaryData?.specific ?? [];
const hasGlossary = glossaryShared.length > 0 || glossarySpecific.length > 0;
// Load the link-ID → term map (keyed by data-item-id linkId UUID)
const linkMapPath = join(process.cwd(), 'src/data/glossary-link-map.json');
const termMap: Record<string, { title: string; slug: string; description: string }> = existsSync(linkMapPath)
  ? JSON.parse(readFileSync(linkMapPath, 'utf-8'))
  : {};

const stages = content?.stages ?? [];
const overviewHtml = content?.overview ?? '';
const overviewSections: Array<{heading:string|null,level:number|null,isAccordion:boolean,html:string}> = content?.overviewSections ?? [];
const hasContent = stages.length > 0;
const rationaleHtml = content?.rationale ?? '';
const aimHtml = content?.aim ?? '';

// Stage → year range label
const lifeSkillsYears = s.stage === '11–12' ? 'Years 11–12' : 'Years 7–10';

// Cross-stage outcomes matrix
const allFocusAreaNames: string[] = [];
{
  const seen = new Set<string>();
  for (const st of stages) {
    for (const fa of (st as any).focusAreas ?? []) {
      if (!seen.has(fa.title)) {
        seen.add(fa.title);
        allFocusAreaNames.push(fa.title);
      }
    }
  }
}
type OutcomeItem = { code: string; description: string };
const stageOutcomesMaps: Record<string, OutcomeItem[]>[] = (stages as any[]).map(st => {
  const map: Record<string, OutcomeItem[]> = {};
  for (const fa of st.focusAreas ?? []) {
    if (!map[fa.title]) map[fa.title] = [];
    map[fa.title].push(...(fa.outcomes ?? []));
  }
  return map;
});
const stageYears: Record<string, string> = {
  early_stage_1: 'Kindergarten',
  stage_1: 'Years 1–2',
  stage_2: 'Years 3–4',
  stage_3: 'Years 5–6',
  stage_4: 'Years 7–8',
  stage_5: 'Years 9–10',
  year_11: 'Year 11',
  year_12: 'Year 12',
  stage_6: 'Years 11–12',
  life_skills: lifeSkillsYears,
};


const klaColor = `var(--kla-${s.kla ?? 'english'})`;

const stageLabels: Record<string, string> = {
  'K–6':   'Primary (K–6)',
  'K–10':  'Primary & Secondary (K–10)',
  '7–8':   'Early Secondary (7–8)',
  '7–10':  'Secondary (7–10)',
  '11–12': 'Senior Secondary (11–12)',
};
const stageLabel = stageLabels[s.stage] ?? s.stage;

const classifParts: string[] = [];
if (s.isMandatory && s.isElective) classifParts.push('Mandatory + Elective choice');
else if (s.isMandatory) classifParts.push('Mandatory');
else if (s.isElective) classifParts.push(`Elective${s.electivePeriods ? ` (${s.electivePeriods} periods)` : ''}`);

// Merge focus areas that share the same title (data sometimes splits one FA across multiple entries)
function mergeFocusAreas(focusAreas: any[]): any[] {
  const order: string[] = [];
  const map = new Map<string, any>();
  for (const fa of focusAreas) {
    if (!map.has(fa.title)) {
      order.push(fa.title);
      map.set(fa.title, {
        ...fa,
        outcomes: [...(fa.outcomes ?? [])],
        contentGroups: [...(fa.contentGroups ?? [])],
      });
    } else {
      const merged = map.get(fa.title)!;
      const seenCodes = new Set(merged.outcomes.map((o: any) => o.code));
      for (const oc of (fa.outcomes ?? [])) {
        if (!seenCodes.has(oc.code)) {
          merged.outcomes.push(oc);
          seenCodes.add(oc.code);
        }
      }
      merged.contentGroups.push(...(fa.contentGroups ?? []));
    }
  }
  return order.map(t => map.get(t)!);
}

// Overview nav helpers
function ovHeadingToId(heading: string): string {
  return 'ov-' + heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const overviewNavItems: Array<{ id: string; label: string; isAccordion: boolean }> =
  overviewSections
    .filter(sec => Boolean(sec.heading))
    .map(sec => ({
      id: ovHeadingToId(sec.heading!),
      label: sec.heading!,
      isAccordion: sec.isAccordion,
    }));

// Always add Course details at the end if there are enough nav items
if (overviewNavItems.length >= 2) {
  overviewNavItems.push({ id: 'ov-course-details', label: 'Course details', isAccordion: false });
}

const showOverviewNav = overviewNavItems.length >= 3;


---

<Layout title={s.name} description={`${s.name} — NSW ${s.klaLabel} syllabus, ${s.stage}.`}>

  <!-- ─── Breadcrumb ──────────────────────────────────────────────────────── -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <wa-icon name="chevron-right" variant="solid"></wa-icon>
    <a href="/syllabuses">Syllabuses</a>
    <wa-icon name="chevron-right" variant="solid"></wa-icon>
    <span>{s.name}</span>
  </nav>

  <!-- ─── Header ─────────────────────────────────────────────────────────── -->
  <header class="syl-header" style={`--accent: ${klaColor}`}>
    <div class="syl-header-chips">
      <span class="kla-chip" style={`--chip-kla: ${klaColor}`}>{s.klaLabel}</span>
      {s.type === 'LS' && <span class="ls-chip">Life Skills</span>}
      {s.hasContent && (
        <span class="pub-chip">
          <wa-icon name="circle-check" variant="solid"></wa-icon>
          Live on curriculum.nsw.edu.au
        </span>
      )}
    </div>
    <h1>{s.name}</h1>
    <p class="syl-subtitle">{stageLabel}{s.publicationYear ? ` · Published ${s.publicationYear}` : ''}</p>
  </header>

  {hasContent ? (
    <>
      <!-- ─── Tab group ────────────────────────────────────────────────────── -->
      <wa-tab-group class="syl-tabs" active="overview">
        <wa-tab panel="overview" active>Overview</wa-tab>
        <wa-tab panel="aim">Aim and rationale</wa-tab>
        <wa-tab panel="outcomes">Outcomes</wa-tab>
        <wa-tab panel="content">Content</wa-tab>
        <wa-tab panel="assessment">Assessment</wa-tab>
        <wa-tab panel="glossary">Glossary</wa-tab>

        <!-- ── Overview panel ─────────────────────────────────────────────── -->
        <wa-tab-panel name="overview" active>

          <div class={showOverviewNav ? 'ov-layout' : undefined}>

            {showOverviewNav && (
              <nav class="ov-nav" aria-label="Overview sections">
                <ul class="onav-list">
                  {overviewNavItems.map(item => (
                    <li>
                      <a class="onav-link" href={`#${item.id}`}
                         data-accordion={item.isAccordion ? 'true' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}

            <div class={showOverviewNav ? 'ov-body' : undefined}>

              {overviewSections.length > 0 ? (
                overviewSections.map(sec => {
                  const secId = sec.heading ? ovHeadingToId(sec.heading) : undefined;
                  return sec.isAccordion ? (
                    <wa-details class="ov-accordion" summary={sec.heading ?? ''} id={secId}>
                      <div class="prose" set:html={sec.html} />
                    </wa-details>
                  ) : (
                    <section class="ov-section" id={secId}>
                      {sec.heading && <h2 class="section-heading">{sec.heading}</h2>}
                      <div class="prose" set:html={sec.html} />
                    </section>
                  );
                })
              ) : overviewHtml ? (
                <section class="ov-section">
                  <div class="prose" set:html={overviewHtml} />
                </section>
              ) : null}

              <div class="info-cards" id="ov-course-details">
            <div class="info-card">
              <h2>Course details</h2>
              <dl>
                <dt>Learning area</dt><dd>{s.klaLabel}</dd>
                <dt>Stage</dt><dd>{s.stage}</dd>
                <dt>Course type</dt><dd>{s.type === 'LS' ? 'Life Skills' : 'Mainstream'}</dd>
                {classifParts.length > 0 && <><dt>Classification</dt><dd>{classifParts.join(', ')}</dd></>}
                <dt>Published</dt><dd>{s.publicationYear}</dd>
              </dl>
            </div>
            <div class="info-card">
              <h2>Links</h2>
              <div class="link-list">
                {s.curriculumUrl && (
                  <a href={s.curriculumUrl} target="_blank" rel="noopener" class="link-row link-primary">
                    <wa-icon name="arrow-up-right-from-square" variant="solid"></wa-icon>
                    <span>
                      <strong>curriculum.nsw.edu.au</strong>
                      <small>Current NESA site</small>
                    </span>
                  </a>
                )}
                {s.nesaUrl && (
                  <a href={s.nesaUrl} target="_blank" rel="noopener" class="link-row">
                    <wa-icon name="arrow-up-right-from-square" variant="regular"></wa-icon>
                    <span>
                      <strong>educationstandards.nsw.edu.au</strong>
                      <small>Legacy NESA site</small>
                    </span>
                  </a>
                )}
              </div>
            </div>
          </div>{/* info-cards */}

            </div>{/* ov-body */}
          </div>{/* ov-layout */}
        </wa-tab-panel>

        <!-- ── Aim and rationale panel ──────────────────────────────────────── -->
        <wa-tab-panel name="aim">
          {(aimHtml || rationaleHtml) ? (
            <div class="aim-rationale">
              {aimHtml && (
                <section class="ov-section">
                  <h2 class="section-heading">Aim</h2>
                  <div class="prose" set:html={aimHtml} />
                </section>
              )}
              {rationaleHtml && (
                <section class="ov-section">
                  <h2 class="section-heading">Rationale</h2>
                  <div class="prose" set:html={rationaleHtml} />
                </section>
              )}
            </div>
          ) : (
            <div class="coming-soon">
              <wa-icon name="clock" variant="regular"></wa-icon>
              <p>Aim and rationale not available for this syllabus.</p>
            </div>
          )}
        </wa-tab-panel>

        <!-- ── Outcomes panel ─────────────────────────────────────────────── -->
        <wa-tab-panel name="outcomes">

          <!-- View switcher -->
          <div class="ov-switcher">
            <p class="ov-switcher-text">
              View outcomes stage by stage, or switch to the continuum of learning view to see how outcomes build across focus areas as students progress through each stage.
            </p>
            <div class="ov-toggle" role="group" aria-label="Outcomes view">
              <button class="ov-toggle-btn active" data-target="outcomes-default">Default</button>
              <button class="ov-toggle-btn" data-target="outcomes-continuum">Continuum of learning</button>
            </div>
          </div>

          <!-- Default view: stage columns -->
          <div id="outcomes-default" class="outcomes-view">
            <div class="stage-columns">
              {(stages as any[]).map(st => (
                <div class="stage-col">
                  <div class="stage-col-header">
                    <span class="stage-col-name">{st.name}</span>
                    {stageYears[st.codename] && (
                      <span class="stage-col-years">{stageYears[st.codename]}</span>
                    )}
                  </div>
                  <div class="stage-col-body">
                    {(st.focusAreas ?? []).map((fa: any) => (
                      fa.outcomes.length > 0 && (
                        fa.outcomes.map((oc: OutcomeItem) => (
                          <div class="outcome-card">
                            <span class="outcome-code">{oc.code}</span>
                            <span class="outcome-fa-title">{fa.title}</span>
                            <div class="outcome-desc" set:html={oc.description} />
                          </div>
                        ))
                      )
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Continuum view: frozen-left matrix -->
          <div id="outcomes-continuum" class="outcomes-view" hidden>
            <div class="om-scroll">
              <div
                class="outcomes-matrix"
                style={`grid-template-columns: 200px repeat(${stages.length}, 300px)`}
              >
                {/* Header row */}
                <div class="om-cell om-header om-frozen">Outcome</div>
                {(stages as any[]).map(st => (
                  <div class="om-cell om-header">
                    <span class="om-stage-name">{st.name}</span>
                    {stageYears[st.codename] && (
                      <span class="om-stage-years">{stageYears[st.codename]}</span>
                    )}
                  </div>
                ))}

                {/* Data rows — one per focus area */}
                {allFocusAreaNames.map((faName, ri) => (
                  <>
                    <div class={`om-cell om-row-label om-frozen${ri % 2 === 1 ? ' om-stripe' : ''}`}>
                      {faName}
                    </div>
                    {stageOutcomesMaps.map((map) => (
                      <div class={`om-cell om-data${ri % 2 === 1 ? ' om-stripe' : ''}`}>
                        {(map[faName] ?? []).length > 0
                          ? (map[faName] ?? []).map((oc: OutcomeItem) => (
                              <div class="outcome-card">
                                <span class="outcome-code">{oc.code}</span>
                                <div class="outcome-desc" set:html={oc.description} />
                              </div>
                            ))
                          : <span class="om-empty">No outcome for this stage</span>
                        }
                      </div>
                    ))}
                  </>
                ))}
              </div>
            </div>
          </div>

        </wa-tab-panel>

        <!-- ── Content panel ──────────────────────────────────────────────── -->
        <wa-tab-panel name="content">
          <div class="content-layout">

            <!-- Left nav -->
            <nav class="content-nav" aria-label="Content navigation">
              {(stages as any[]).map(st => {
                return (
                  <div class="cnav-stage">
                    <a class="cnav-stage-link" href={`#cs-${st.codename}`}>
                      {st.name}
                      {stageYears[st.codename] && (
                        <span class="cnav-stage-years">{stageYears[st.codename]}</span>
                      )}
                    </a>
                    <ul class="cnav-fa-list">
                      {mergeFocusAreas(st.focusAreas ?? []).map((fa: any) => {
                        const faId = fa.title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
                        return (
                          <li>
                            <a class="cnav-fa-link" href={`#cfa-${st.codename}-${faId}`}>
                              {fa.title}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                );
              })}
            </nav>

            <!-- Content body -->
            <div class="content-body">

              <!-- Examples toolbar -->
              <div class="examples-toolbar">
                <button class="examples-toggle" id="examples-toggle" data-state="hidden" aria-pressed="false">
                  <wa-icon name="eye" variant="regular"></wa-icon>
                  Show examples
                </button>
              </div>

              {(stages as any[]).map(st => (
                  <section class="content-stage" id={`cs-${st.codename}`}>
                    <div class="content-stage-header">
                      <h2 class="content-stage-name">{st.name}</h2>
                      {stageYears[st.codename] && (
                        <span class="content-stage-years">{stageYears[st.codename]}</span>
                      )}
                    </div>

                    {mergeFocusAreas(st.focusAreas ?? []).map((fa: any) => {
                      const faId = fa.title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
                      const faOutcomes: any[] = fa.outcomes ?? [];
                      return (
                        <div class="content-fa" id={`cfa-${st.codename}-${faId}`}>
                          <div class="fa-card">
                            <div class="fa-section-head">
                              <span class="fa-section-title">{fa.title}</span>
                            </div>
                            <div class="fa-card-body">
                              {faOutcomes.length > 0 && (
                                <div class="fa-outcomes-wrap">
                                  <div class="fao-header">Outcomes</div>
                                  <ul class="fa-outcomes-list">
                                    {faOutcomes.map((oc: any) => (
                                      <li class="fao-item">
                                        <span class="fao-code">{oc.code}</span>
                                        <div class="fao-desc" set:html={oc.description} />
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              )}

                              {(fa.contentGroups ?? []).map((cg: any) => {
                                const cgHasExamples = (cg.items ?? []).some((ci: any) => Boolean(ci.examples));
                                return (
                                  <div class="cg-section">
                                    <div class="cg-table-wrap">
                                      <table class="cg-table">
                                        <thead>
                                          <tr>
                                            <th class="cg-th-content">{cg.title}</th>
                                            {cgHasExamples && <th class="cg-th-examples examples-col">Examples</th>}
                                          </tr>
                                        </thead>
                                        <tbody>
                                          {(cg.items ?? []).map((ci: any) => (
                                            <tr>
                                              <td class="ci-td"><div set:html={ci.text} /></td>
                                              {cgHasExamples && (
                                                <td class="ci-ex-td examples-col">
                                                  {ci.examples && <div set:html={ci.examples} />}
                                                </td>
                                              )}
                                            </tr>
                                          ))}
                                        </tbody>
                                      </table>
                                    </div>
                                  </div>
                                );
                              })}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </section>
              ))}
            </div>
          </div>
        </wa-tab-panel>

        <!-- ── Assessment panel ───────────────────────────────────────────── -->
        <wa-tab-panel name="assessment">
          <div class="coming-soon">
            <wa-icon name="clock" variant="regular"></wa-icon>
            <p>Assessment information is not yet extracted from the source data.</p>
            {s.curriculumUrl && (
              <a href={`${s.curriculumUrl}/assessment`} target="_blank" rel="noopener" class="ext-link">
                View assessment on curriculum.nsw.edu.au
                <wa-icon name="arrow-up-right-from-square" variant="solid"></wa-icon>
              </a>
            )}
          </div>
        </wa-tab-panel>

        <!-- ── Glossary panel ─────────────────────────────────────────────── -->
        <wa-tab-panel name="glossary">
          {hasGlossary ? (
            <div class="glossary-panel">

              {/* External link row */}
              {s.curriculumUrl && (
                <a href={`${s.curriculumUrl}/glossary`} target="_blank" rel="noopener" class="glossary-ext-link">
                  <wa-icon name="arrow-up-right-from-square" variant="solid"></wa-icon>
                  View full glossary on curriculum.nsw.edu.au
                </a>
              )}

              {/* Syllabus-specific terms */}
              {glossarySpecific.length > 0 && (
                <section class="glossary-section">
                  <h2 class="glossary-section-heading">{s.name} terms</h2>
                  <dl class="glossary-list">
                    {glossarySpecific.map(term => (
                      <div class="glossary-entry" id={`gt-${term.codename}`}>
                        <dt class="glossary-term">{term.title}</dt>
                        {term.description && <dd class="glossary-def prose" set:html={term.description} />}
                      </div>
                    ))}
                  </dl>
                </section>
              )}

              {/* Shared terms (apply to all syllabuses) */}
              {glossaryShared.length > 0 && (
                <section class="glossary-section">
                  <h2 class="glossary-section-heading">Shared terms</h2>
                  <p class="glossary-section-note">These terms apply across all NSW syllabuses.</p>
                  <dl class="glossary-list">
                    {glossaryShared.map(term => (
                      <div class="glossary-entry" id={`gt-${term.codename}`}>
                        <dt class="glossary-term">{term.title}</dt>
                        {term.description && <dd class="glossary-def prose" set:html={term.description} />}
                      </div>
                    ))}
                  </dl>
                </section>
              )}
            </div>
          ) : (
            <div class="coming-soon">
              <wa-icon name="book-open" variant="regular"></wa-icon>
              <p>Glossary is not yet available for this syllabus.</p>
              {s.curriculumUrl && (
                <a href={`${s.curriculumUrl}/glossary`} target="_blank" rel="noopener" class="ext-link">
                  View glossary on curriculum.nsw.edu.au
                  <wa-icon name="arrow-up-right-from-square" variant="solid"></wa-icon>
                </a>
              )}
            </div>
          )}
        </wa-tab-panel>
      </wa-tab-group>

      <!-- FA pager — fixed bottom bar, shown only when content tab is active -->
      <div id="fa-pager" class="fa-pager" hidden>
        <button id="fa-pager-prev" class="fa-pager-btn fa-pager-prev-btn" type="button" aria-label="Previous focus area">
          <wa-icon name="arrow-left" variant="solid"></wa-icon>
          <span id="fa-pager-prev-label" class="fa-pager-label"></span>
        </button>
        <div class="fa-pager-center">
          <span id="fa-pager-counter" class="fa-pager-counter"></span>
        </div>
        <button id="fa-pager-next" class="fa-pager-btn fa-pager-next-btn" type="button" aria-label="Next focus area">
          <span id="fa-pager-next-label" class="fa-pager-label"></span>
          <wa-icon name="arrow-right" variant="solid"></wa-icon>
        </button>
      </div>
    </>
  ) : (
    <div class="no-content">
      <div class="info-cards">
        <div class="info-card">
          <h2>Course details</h2>
          <dl>
            <dt>Learning area</dt><dd>{s.klaLabel}</dd>
            <dt>Stage</dt><dd>{s.stage}</dd>
            <dt>Course type</dt><dd>{s.type === 'LS' ? 'Life Skills' : 'Mainstream'}</dd>
            {classifParts.length > 0 && <><dt>Classification</dt><dd>{classifParts.join(', ')}</dd></>}
            {s.publicationYear && <><dt>Published</dt><dd>{s.publicationYear}</dd></>}
          </dl>
        </div>
        <div class="info-card">
          <div class="coming-soon">
            <wa-icon name="clock" variant="regular"></wa-icon>
            <p>Content for this syllabus is not yet available on curriculum.nsw.edu.au.</p>
            {s.curriculumUrl && (
              <a href={s.curriculumUrl} target="_blank" rel="noopener" class="ext-link">
                Check curriculum.nsw.edu.au
                <wa-icon name="arrow-up-right-from-square" variant="solid"></wa-icon>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- ─── Back link ───────────────────────────────────────────────────────── -->
  <div class="back-link">
    <a href="/syllabuses">
      <wa-icon name="arrow-left" variant="solid"></wa-icon>
      Back to all syllabuses
    </a>
  </div>
<!-- ── Glossary popover ─────────────────────────────────────────────── -->
<div id="gloss-pop" role="tooltip" aria-live="polite" hidden>
  <div class="gp-header">
    <span id="gp-title" class="gp-title"></span>
    <button id="gp-close" class="gp-close" aria-label="Close">
      <wa-icon name="xmark" variant="solid"></wa-icon>
    </button>
  </div>
  <div id="gp-body" class="gp-body"></div>
  <div class="gp-footer">
    <a id="gp-link" href="#glossary" class="gp-link">View in glossary</a>
  </div>
</div>

</Layout>

<script define:vars={{ termMap }}>
  // ── Glossary inline popovers ────────────────────────────────────────
  const pop     = document.getElementById('gloss-pop');
  const popTitle = document.getElementById('gp-title');
  const popBody  = document.getElementById('gp-body');
  const popLink  = document.getElementById('gp-link');
  const popClose = document.getElementById('gp-close');
  if (!pop) throw new Error('gloss-pop not found');

  let currentAnchor = null;

  function showPop(anchor, term) {
    popTitle.textContent = term.title;
    popBody.innerHTML = term.description || '<em>No definition available.</em>';
    // Link to glossary tab anchor
    const codename = anchor.dataset.glossCn || '';
    popLink.href = codename ? `#gt-${codename}` : '#';
    popLink.onclick = (e) => {
      e.preventDefault();
      hidePop();
      // Switch to glossary tab
      const tabGroup = document.querySelector('wa-tab-group');
      if (tabGroup) tabGroup.show('glossary');
      // Scroll to term after tab switch
      const target = codename ? document.getElementById(`gt-${codename}`) : null;
      if (target) {
        setTimeout(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }), 120);
      }
    };

    // Position near anchor
    const rect = anchor.getBoundingClientRect();
    const scrollY = window.scrollY;
    const scrollX = window.scrollX;
    pop.hidden = false;

    // Calculate position (prefer below, flip above if near bottom)
    const popH = pop.offsetHeight || 180;
    const spaceBelow = window.innerHeight - rect.bottom;
    const top = spaceBelow > popH + 8
      ? scrollY + rect.bottom + 6
      : scrollY + rect.top - popH - 6;
    let left = scrollX + rect.left;
    const popW = pop.offsetWidth || 280;
    if (left + popW > scrollX + window.innerWidth - 16) {
      left = scrollX + window.innerWidth - popW - 16;
    }
    pop.style.top = `${top}px`;
    pop.style.left = `${Math.max(8, left)}px`;
    currentAnchor = anchor;
  }

  function hidePop() {
    pop.hidden = true;
    currentAnchor = null;
  }

  // Intercept clicks on data-item-id links
  document.addEventListener('click', (e) => {
    const anchor = e.target.closest('a[data-item-id]');
    if (anchor) {
      e.preventDefault();
      const id = anchor.dataset.itemId;
      if (anchor === currentAnchor) { hidePop(); return; }
      const term = id && termMap[id];
      if (term) {
        showPop(anchor, term);
      }
      return;
    }
    // Close button
    if (e.target.closest('#gp-close')) { hidePop(); return; }
    // Click outside
    if (!pop.contains(e.target)) hidePop();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hidePop();
  });
</script>

