---
import Layout from '../../layouts/Layout.astro';
import syllabuses from '../../data/syllabuses.json';

// ─── Filter dimensions ────────────────────────────────────────────────────────
const klas = [
  { slug: 'creative-arts', label: 'Creative Arts' },
  { slug: 'english',       label: 'English' },
  { slug: 'hsie',          label: 'HSIE' },
  { slug: 'languages',     label: 'Languages' },
  { slug: 'mathematics',   label: 'Mathematics' },
  { slug: 'pdhpe',         label: 'PDHPE' },
  { slug: 'science',       label: 'Science' },
  { slug: 'tas',           label: 'TAS' },
];

const stages = [
  { value: 'k-6',   label: 'K–6' },
  { value: 'k-10',  label: 'K–10' },
  { value: '7-8',   label: '7–8' },
  { value: '7-10',  label: '7–10' },
  { value: '11-12', label: '11–12' },
];

// Normalise stage for data attribute (en-dash → hyphen, lowercase)
function stageKey(s: string) {
  return s.replace(/–/g, '-').toLowerCase();
}

const total = syllabuses.length;
---

<Layout title="Syllabuses" description="All NSW syllabuses — browse by KLA, stage, and course type.">

  <!-- ─── Filter bar ──────────────────────────────────────────────────────────── -->
  <div class="filter-bar">
    <div class="filter-left">
      <label class="filter-label" for="kla-select">KLA</label>
      <select id="kla-select" class="filter-select">
        <option value="">All KLAs</option>
        {klas.map(k => <option value={k.slug}>{k.label}</option>)}
      </select>

      <label class="filter-label" for="stage-select">Stage</label>
      <select id="stage-select" class="filter-select">
        <option value="">All stages</option>
        {stages.map(s => <option value={s.value}>{s.label}</option>)}
      </select>
    </div>

    <div class="filter-chips">
      <button class="chip chip-active" data-filter="type" data-value="">All</button>
      <button class="chip" data-filter="type" data-value="ms">Mainstream</button>
      <button class="chip" data-filter="type" data-value="ls">Life Skills</button>
      <span class="chip-divider"></span>
      <button class="chip chip-pub" data-filter="pub" data-value="yes">On curriculum.nsw.edu.au</button>
    </div>

    <span class="filter-count">
      <span id="syl-count">{total}</span> syllabuses
    </span>
  </div>

  <!-- ─── Grid ───────────────────────────────────────────────────────────────── -->
  <div class="syl-grid" id="syl-grid">
    {syllabuses.map(s => (
      <a
        href={`/syllabuses/${s.slug}`}
        class="syl-card"
        data-kla={s.kla ?? ''}
        data-stage={stageKey(s.stage)}
        data-type={(s.type ?? 'ms').toLowerCase()}
        data-pub={s.published ? 'yes' : 'no'}
      >
        <div class="syl-card-top">
          <span class="kla-chip" style={`--chip-kla: var(--kla-${s.kla ?? 'english'})`}>
            {s.klaLabel}
          </span>
          {s.type === 'LS' && <span class="ls-chip">Life Skills</span>}
        </div>

        <span class="syl-name">{s.name}</span>

        <div class="syl-card-bottom">
          <span class="stage-badge">{s.stage}</span>
          {s.isMandatory && <span class="classif-badge mandatory">Mandatory</span>}
          {s.isElective && !s.isMandatory && <span class="classif-badge elective">Elective</span>}
          {s.isMandatory && s.isElective && <span class="classif-badge elective">+Elective</span>}
          {s.published && (
            <span class="pub-badge" title="Available on curriculum.nsw.edu.au">
              <wa-icon name="circle-check" variant="solid"></wa-icon>
              Live
            </span>
          )}
        </div>
      </a>
    ))}
  </div>

  <p class="empty-state" id="syl-empty" hidden>No syllabuses match the current filters.</p>

</Layout>

<style>
  /* ─── Filter bar ─────────────────────────────────────────────────────────── */
  .filter-bar {
    position: sticky;
    top: 4rem;
    z-index: 4;
    background: white;
    border-bottom: 1px solid var(--wa-color-neutral-200);
    padding: var(--wa-space-s) var(--wa-space-xl);
    display: flex;
    align-items: center;
    gap: var(--wa-space-m);
    flex-wrap: wrap;
    margin-inline: calc(-1 * var(--wa-space-xl));
  }

  .filter-left {
    display: flex;
    align-items: center;
    gap: var(--wa-space-s);
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--wa-color-neutral-500);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .filter-select {
    font-size: 0.875rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--wa-color-neutral-300);
    border-radius: var(--wa-border-radius-s);
    background: white;
    color: var(--wa-color-neutral-900);
    cursor: pointer;
  }

  .filter-chips {
    display: flex;
    align-items: center;
    gap: var(--wa-space-xs);
    flex-wrap: wrap;
  }

  .chip {
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--wa-color-neutral-300);
    background: white;
    color: var(--wa-color-neutral-600);
    cursor: pointer;
    transition: background 0.12s, border-color 0.12s, color 0.12s;
  }

  .chip:hover {
    border-color: var(--site-brand);
    color: var(--site-brand);
  }

  .chip.chip-active {
    background: var(--site-brand);
    border-color: var(--site-brand);
    color: white;
  }

  .chip-pub.chip-active {
    background: #15803d;
    border-color: #15803d;
    color: white;
  }

  .chip-divider {
    width: 1px;
    height: 1.25rem;
    background: var(--wa-color-neutral-200);
    display: inline-block;
    margin-inline: var(--wa-space-2xs);
  }

  .filter-count {
    margin-inline-start: auto;
    font-size: 0.85rem;
    color: var(--wa-color-neutral-500);
    white-space: nowrap;
  }

  /* ─── Syllabus grid ──────────────────────────────────────────────────────── */
  .syl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--wa-space-m);
    margin-block-start: var(--wa-space-l);
  }

  .syl-card {
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-xs);
    padding: var(--wa-space-m);
    background: white;
    border: 1px solid var(--wa-color-neutral-200);
    border-left: 3px solid var(--kla-color, var(--wa-color-neutral-300));
    border-radius: var(--wa-border-radius-m);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, transform 0.12s;
  }

  .syl-card {
    --kla-color: var(--kla-english); /* fallback */
  }
  .syl-card[data-kla="english"]       { --kla-color: var(--kla-english); }
  .syl-card[data-kla="mathematics"]   { --kla-color: var(--kla-mathematics); }
  .syl-card[data-kla="science"]       { --kla-color: var(--kla-science); }
  .syl-card[data-kla="tas"]           { --kla-color: var(--kla-tas); }
  .syl-card[data-kla="hsie"]          { --kla-color: var(--kla-hsie); }
  .syl-card[data-kla="creative-arts"] { --kla-color: var(--kla-creative-arts); }
  .syl-card[data-kla="pdhpe"]         { --kla-color: var(--kla-pdhpe); }
  .syl-card[data-kla="languages"]     { --kla-color: var(--kla-languages); }

  .syl-card:hover {
    box-shadow: var(--wa-shadow-m);
    transform: translateY(-1px);
  }

  .syl-card-top {
    display: flex;
    gap: var(--wa-space-xs);
    flex-wrap: wrap;
    align-items: center;
  }

  .kla-chip {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--chip-kla) 12%, white);
    color: var(--chip-kla);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ls-chip {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--wa-color-neutral-100);
    color: var(--wa-color-neutral-600);
    font-style: italic;
  }

  .syl-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--wa-color-neutral-900);
    line-height: 1.35;
    flex: 1;
  }

  .syl-card-bottom {
    display: flex;
    align-items: center;
    gap: var(--wa-space-xs);
    flex-wrap: wrap;
    margin-block-start: auto;
    padding-block-start: var(--wa-space-xs);
  }

  .stage-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--wa-color-neutral-600);
    background: var(--wa-color-neutral-100);
    padding: 0.15rem 0.45rem;
    border-radius: var(--wa-border-radius-s);
  }

  .classif-badge {
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--wa-border-radius-s);
  }
  .classif-badge.mandatory {
    background: #dbeafe;
    color: #1e40af;
  }
  .classif-badge.elective {
    background: #fef3c7;
    color: #92400e;
  }

  .pub-badge {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #15803d;
  }

  .empty-state {
    text-align: center;
    padding: var(--wa-space-3xl);
    color: var(--wa-color-neutral-500);
  }
</style>

<script>
  // ─── Filter logic ─────────────────────────────────────────────────────────
  const grid   = document.getElementById('syl-grid')!;
  const count  = document.getElementById('syl-count')!;
  const empty  = document.getElementById('syl-empty') as HTMLParagraphElement;
  const klaEl  = document.getElementById('kla-select') as HTMLSelectElement;
  const stageEl= document.getElementById('stage-select') as HTMLSelectElement;

  let activeType = '';
  let activePub  = false;

  // Pre-set filters from URL params (e.g. /syllabuses?kla=english&stage=k-10)
  const params = new URLSearchParams(location.search);
  if (params.get('kla'))   klaEl.value   = params.get('kla')!;
  if (params.get('stage')) stageEl.value = params.get('stage')!;

  function applyFilters() {
    const kla   = klaEl.value;
    const stage = stageEl.value;
    const cards = grid.querySelectorAll<HTMLAnchorElement>('.syl-card');
    let visible = 0;

    cards.forEach(card => {
      const matchKla   = !kla   || card.dataset.kla   === kla;
      const matchStage = !stage || card.dataset.stage === stage;
      const matchType  = !activeType || card.dataset.type === activeType;
      const matchPub   = !activePub  || card.dataset.pub  === 'yes';
      const show = matchKla && matchStage && matchType && matchPub;
      card.hidden = !show;
      if (show) visible++;
    });

    count.textContent = String(visible);
    empty.hidden = visible > 0;
  }

  // Dropdowns
  klaEl.addEventListener('change', applyFilters);
  stageEl.addEventListener('change', applyFilters);

  // Type chips
  document.querySelectorAll<HTMLButtonElement>('[data-filter="type"]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-filter="type"]').forEach(b => b.classList.remove('chip-active'));
      btn.classList.add('chip-active');
      activeType = btn.dataset.value!;
      applyFilters();
    });
  });

  // Published chip (toggle)
  document.querySelectorAll<HTMLButtonElement>('[data-filter="pub"]').forEach(btn => {
    btn.addEventListener('click', () => {
      activePub = !activePub;
      btn.classList.toggle('chip-active', activePub);
      applyFilters();
    });
  });
</script>
