---
import Layout from '../../layouts/Layout.astro';
import syllabuses from '../../data/syllabuses.json';

// ─── Filter dimensions ────────────────────────────────────────────────────────
const klas = [
  { slug: 'creative_arts', label: 'Creative Arts' },
  { slug: 'english',       label: 'English' },
  { slug: 'hsie',          label: 'HSIE' },
  { slug: 'languages',     label: 'Languages' },
  { slug: 'mathematics',   label: 'Mathematics' },
  { slug: 'pdhpe',         label: 'PDHPE' },
  { slug: 'science',       label: 'Science' },
  { slug: 'tas',           label: 'TAS' },
];

const stages = [
  { value: 'k-6',   label: 'K–6' },
  { value: 'k-10',  label: 'K–10' },
  { value: '7-8',   label: '7–8' },
  { value: '7-10',  label: '7–10' },
  { value: '11-12', label: '11–12' },
];

// Normalise stage for data attribute (en-dash → hyphen, lowercase)
function stageKey(s: string) {
  return s.replace(/–/g, '-').toLowerCase();
}

// CSS variable helper — normalise underscores to hyphens for CSS var name
function klaVar(kla: string) {
  return `--kla-${kla.replace(/_/g, '-')}`;
}

function klaShortLabel(kla: string, label: string) {
  if (kla === 'tas') return 'TAS';
  if (kla === 'creative_arts') return 'Creative Arts';
  return label;
}

const total = syllabuses.length;
---

<Layout title="Syllabuses" description="All NSW syllabuses — browse by KLA, stage, and course type.">

  <!-- ─── Page intro ────────────────────────────────────────────────────────── -->
  <div class="page-intro">
    <div class="intro-prose">
      <h1 class="page-title">Syllabuses</h1>
      <p>
        Outcomes from <strong>{total}</strong> NSW syllabuses. Full syllabus content available via&nbsp;
        <a href="https://curriculum.nsw.edu.au/" target="_blank" rel="noopener">NSW Curriculum website</a>.
      </p>
      <p>
        Filter by KLA, stage, or course type below.
      </p>
    </div>

    <aside class="related-links">
      <h2 class="related-links-heading">
        <wa-icon name="link" variant="solid"></wa-icon>
        Related links
      </h2>
      <ul class="related-links-list">
        <li>
          <a href="https://curriculum.nsw.edu.au" target="_blank" rel="noopener">
            curriculum.nsw.edu.au
          </a>
        </li>
        <li>
          <a href="https://educationstandards.nsw.edu.au/wps/portal/nesa/home" target="_blank" rel="noopener">
            NESA — educationstandards.nsw.edu.au
          </a>
        </li>
        <li>
          <a href="https://curriculum.nsw.edu.au/use-the-curriculum/planning-supporting-student-learning" target="_blank" rel="noopener">
            Planning and supporting student learning
          </a>
        </li>
        <li>
          <a href="/course-descriptions">
            Course descriptions (enrolment details)
          </a>
        </li>
      </ul>
    </aside>
  </div>

  <!-- ─── Filter bar ────────────────────────────────────────────────────────── -->
  <div class="filter-bar">
    <div class="filter-left">
      <label class="filter-label" for="kla-select">KLA</label>
      <select id="kla-select" class="filter-select">
        <option value="">All KLAs</option>
        {klas.map(k => <option value={k.slug}>{k.label}</option>)}
      </select>

      <label class="filter-label" for="stage-select">Stage</label>
      <select id="stage-select" class="filter-select">
        <option value="">All stages</option>
        {stages.map(s => <option value={s.value}>{s.label}</option>)}
      </select>
    </div>

    <div class="filter-chips">
      <button class="chip chip-active" data-filter="type" data-value="">All</button>
      <button class="chip chip-mainstream" data-filter="type" data-value="ms">Mainstream</button>
      <button class="chip chip-lifeskills" data-filter="type" data-value="ls">Life Skills</button>
      <span class="chip-divider"></span>
      <button class="chip chip-live" data-filter="pub" data-value="yes">Live on curriculum.nsw</button>
    </div>

    <span class="filter-count">
      <span id="syl-count">{total}</span> syllabuses
    </span>
  </div>

  <!-- ─── Table ────────────────────────────────────────────────────────────── -->
  <div class="table-wrap">
    <table class="syl-table" id="syl-table">
      <thead>
        <tr>
          <th class="col-kla">KLA</th>
          <th class="col-name">Syllabus</th>
          <th class="col-stage">Stage</th>
          <th class="col-type">Type</th>
          <th class="col-status">Status</th>
        </tr>
      </thead>
      <tbody>
        {syllabuses.map(s => (
          <tr
            data-kla={s.kla ?? ''}
            data-stage={stageKey(s.stage)}
            data-type={(s.type ?? 'ms').toLowerCase()}
            data-pub={s.hasContent ? 'yes' : 'no'}
          >
            <td class="col-kla">
              <span
                class="kla-chip"
                style={`--chip-kla: var(${klaVar(s.kla ?? 'english')})`}
                title={s.klaLabel}
              >
                {klaShortLabel(s.kla ?? '', s.klaLabel)}
              </span>
            </td>
            <td class="col-name">
              <a href={`/syllabuses/${s.slug}`} class="syl-link">{s.name}</a>
            </td>
            <td class="col-stage">
              <span class="stage-badge">{s.stage}</span>
            </td>
            <td class="col-type">
              {s.type === 'LS'
                ? <span class="type-badge ls">Life Skills</span>
                : <span class="type-badge ms">Mainstream</span>}
            </td>
            <td class="col-status">
              {s.hasContent && (
                <span class="live-badge">
                  <wa-icon name="circle-check" variant="solid"></wa-icon>
                  Live
                </span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="empty-state" id="syl-empty" hidden>No syllabuses match the current filters.</p>

</Layout>

<style>
  /* ─── Page intro ─────────────────────────────────────────────────────────── */
  .page-intro {
    display: grid;
    grid-template-columns: 1fr 22rem;
    gap: var(--wa-space-xl);
    align-items: start;
    margin-block-end: var(--wa-space-l);
  }

  @media (max-width: 768px) {
    .page-intro { grid-template-columns: 1fr; }
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--wa-color-neutral-10);
    margin-block: 0 var(--wa-space-s);
  }

  .intro-prose p {
    font-size: 0.95rem;
    color: var(--wa-color-neutral-30);
    line-height: 1.6;
    margin-block: 0 var(--wa-space-s);
  }

  .intro-prose a {
    color: var(--site-brand);
  }

  /* ─── Related links box ──────────────────────────────────────────────────── */
  .related-links {
    background: white;
    border: 1px solid var(--wa-color-neutral-90);
    border-left: 3px solid var(--site-brand);
    border-radius: var(--wa-border-radius-m);
    padding: var(--wa-space-m) var(--wa-space-l);
  }

  .related-links-heading {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--wa-color-neutral-50);
    margin-block: 0 var(--wa-space-s);
    display: flex;
    align-items: center;
    gap: var(--wa-space-xs);
  }

  .related-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-xs);
  }

  .related-links-list a {
    font-size: 0.875rem;
    color: var(--site-brand);
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 0.3em;
  }

  .related-links-list a::before {
    content: '→';
    font-size: 0.75em;
    color: var(--wa-color-neutral-70);
    flex-shrink: 0;
  }

  .related-links-list a:hover {
    text-decoration: underline;
  }

  /* ─── Filter bar ─────────────────────────────────────────────────────────── */
  .filter-bar {
    position: sticky;
    top: 4rem;
    z-index: 4;
    background: white;
    border-bottom: 1px solid var(--wa-color-neutral-90);
    padding: var(--wa-space-s) var(--wa-space-xl);
    display: flex;
    align-items: center;
    gap: var(--wa-space-m);
    flex-wrap: wrap;
    margin-inline: calc(-1 * var(--wa-space-xl));
  }

  .filter-left {
    display: flex;
    align-items: center;
    gap: var(--wa-space-s);
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--wa-color-neutral-50);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .filter-select {
    font-size: 0.875rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--wa-color-neutral-80);
    border-radius: var(--wa-border-radius-s);
    background: white;
    color: var(--wa-color-neutral-20);
    cursor: pointer;
  }

  .filter-chips {
    display: flex;
    align-items: center;
    gap: var(--wa-space-xs);
    flex-wrap: wrap;
  }

  .chip {
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--wa-color-neutral-80);
    background: white;
    color: var(--wa-color-neutral-40);
    cursor: pointer;
    transition: background 0.12s, border-color 0.12s, color 0.12s;
  }

  .chip:hover {
    border-color: var(--site-brand);
    color: var(--site-brand);
  }

  .chip.chip-active {
    background: var(--site-brand);
    border-color: var(--site-brand);
    color: white;
  }

  .chip-divider {
    width: 1px;
    height: 1.25rem;
    background: var(--wa-color-neutral-90);
    display: inline-block;
    margin-inline: var(--wa-space-2xs);
  }

  /* Type chips */
  .chip-mainstream {
    background: #dcfce7;
    border-color: #86efac;
    color: #166534;
  }
  .chip-mainstream:hover,
  .chip-mainstream.chip-active {
    background: #166534;
    border-color: #166534;
    color: white;
  }

  .chip-lifeskills {
    background: #f3e8ff;
    border-color: #d8b4fe;
    color: #6b21a8;
  }
  .chip-lifeskills:hover,
  .chip-lifeskills.chip-active {
    background: #6b21a8;
    border-color: #6b21a8;
    color: white;
  }

  /* Live chip */
  .chip-live {
    background: #dcfce7;
    border-color: #86efac;
    color: #166534;
  }
  .chip-live:hover,
  .chip-live.chip-active {
    background: #166534;
    border-color: #166534;
    color: white;
  }

  .filter-count {
    margin-inline-start: auto;
    font-size: 0.85rem;
    color: var(--wa-color-neutral-50);
    white-space: nowrap;
  }

  /* ─── Table ──────────────────────────────────────────────────────────────── */
  .table-wrap {
    margin-block-start: var(--wa-space-l);
    overflow-x: auto;
    border: 1px solid var(--wa-color-neutral-90);
    border-radius: var(--wa-border-radius-m);
    background: white;
  }

  .syl-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .syl-table thead {
    background: var(--wa-color-neutral-95);
    border-bottom: 2px solid var(--wa-color-neutral-90);
  }

  .syl-table th {
    text-align: left;
    padding: var(--wa-space-s) var(--wa-space-m);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--wa-color-neutral-50);
    white-space: nowrap;
  }

  .syl-table td {
    padding: var(--wa-space-s) var(--wa-space-m);
    border-bottom: 1px solid var(--wa-color-neutral-95);
    vertical-align: middle;
    color: var(--wa-color-neutral-20);
  }

  .syl-table tbody tr:last-child td {
    border-bottom: none;
  }

  .syl-table tbody tr:hover td {
    background: var(--wa-color-neutral-95);
  }

  /* Column widths */
  .col-kla     { width: 8rem; }
  .col-name    { min-width: 18rem; }
  .col-stage   { width: 7rem; }
  .col-type    { width: 8rem; }
  .col-status  { width: 5rem; }

  /* KLA chip */
  .kla-chip {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--chip-kla) 12%, white);
    color: var(--chip-kla);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    display: inline-block;
  }

  /* Syllabus link */
  .syl-link {
    color: var(--site-brand);
    text-decoration: none;
    font-weight: 500;
  }
  .syl-link:hover { text-decoration: underline; }

  /* Stage badge */
  .stage-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--wa-color-neutral-40);
    background: var(--wa-color-neutral-95);
    padding: 0.15rem 0.45rem;
    border-radius: var(--wa-border-radius-s);
    white-space: nowrap;
  }

  /* Type badge */
  .type-badge {
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--wa-border-radius-s);
    font-weight: 500;
    white-space: nowrap;
  }
  .type-badge.ms { background: #dcfce7; color: #166534; }
  .type-badge.ls { background: #f3e8ff; color: #6b21a8; }

  /* Live badge */
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #166534;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: var(--wa-space-3xl);
    color: var(--wa-color-neutral-50);
  }
</style>

<script>
  const table    = document.getElementById('syl-table') as HTMLTableElement;
  const countEl  = document.getElementById('syl-count')!;
  const emptyEl  = document.getElementById('syl-empty') as HTMLParagraphElement;
  const klaEl    = document.getElementById('kla-select') as HTMLSelectElement;
  const stageEl  = document.getElementById('stage-select') as HTMLSelectElement;

  let activeType = '';
  let activePub  = false;

  // Pre-set filters from URL params (e.g. /syllabuses?kla=english&stage=k-10)
  const params = new URLSearchParams(location.search);
  if (params.get('kla'))   klaEl.value   = params.get('kla')!;
  if (params.get('stage')) stageEl.value = params.get('stage')!;

  function applyFilters() {
    const kla   = klaEl.value;
    const stage = stageEl.value;
    const rows  = table.querySelectorAll<HTMLTableRowElement>('tbody tr');
    let visible = 0;

    rows.forEach(row => {
      const matchKla   = !kla        || row.dataset.kla   === kla;
      const matchStage = !stage      || row.dataset.stage === stage;
      const matchType  = !activeType || row.dataset.type  === activeType;
      const matchPub   = !activePub  || row.dataset.pub   === 'yes';
      const show = matchKla && matchStage && matchType && matchPub;
      row.hidden = !show;
      if (show) visible++;
    });

    countEl.textContent = String(visible);
    emptyEl.hidden = visible > 0;
  }

  klaEl.addEventListener('change', applyFilters);
  stageEl.addEventListener('change', applyFilters);

  // Type chips — single select
  document.querySelectorAll<HTMLButtonElement>('[data-filter="type"]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-filter="type"]').forEach(b => b.classList.remove('chip-active'));
      btn.classList.add('chip-active');
      activeType = btn.dataset.value!;
      applyFilters();
    });
  });

  // Live chip — toggle
  document.querySelectorAll<HTMLButtonElement>('[data-filter="pub"]').forEach(btn => {
    btn.addEventListener('click', () => {
      activePub = !activePub;
      btn.classList.toggle('chip-active', activePub);
      applyFilters();
    });
  });

  // Run once to apply any URL params
  applyFilters();
</script>
